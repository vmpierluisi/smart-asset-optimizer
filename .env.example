# ---------------------------------------------------------------------------
# Smart Asset Optimizer — environment variables
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Frontend (Vite) -------------------------------------------------------
# Exposed to the browser — only put PUBLIC values here (the anon/publishable
# key is safe to expose; it is protected by Row Level Security).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Mock mode: run the app entirely on bundled fixture data with NO API keys and
# NO backend calls — the recommended default for local dev and portfolio
# reviewers (flawless, no rate limits). Set to "false" to use live data from the
# deployed edge functions (requires the provider secrets below + a Twelve Data
# plan that tolerates the app's request volume). If unset and no backend is
# configured, the app auto-enables mock mode.
VITE_USE_LOCAL_STOCK_DATA=true

# ---------------------------------------------------------------------------
# Edge-function secrets (server-side only — set via the Supabase dashboard or
# `supabase secrets set`, NOT with a VITE_ prefix). These stay on the server.
#
# The app is consolidated onto a minimal provider set:
#   - Market data & technical indicators: Twelve Data
#   - Market news:                         Marketaux
#   - AI analysis:                         OpenRouter
# ---------------------------------------------------------------------------
# TWELVE_DATA_API_KEY=
# MARKETAUX_DATA_API_KEY=
# OPENROUTER_API_KEY=
